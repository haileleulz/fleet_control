<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_fleet_driver_list" model="ir.ui.view">
        <field name="name">res.partner.driver.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Drivers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="role"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_driver_form" model="ir.ui.view">
        <field name="name">res.partner.driver.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Driver Profile">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Driver Full Name" required="1"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="role" readonly="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_drivers" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('role', '=', 'driver')]</field>
        <field name="context">{'default_role': 'driver', 'default_is_company': False}</field>
        <field name="help" type="html">
            <p class="o_nocontent_smiling_face">Register your first fleet driver here.</p>
        </field>
    </record>

</odoo>
