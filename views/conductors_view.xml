<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_fleet_conductor_list" model="ir.ui.view">
        <field name="name">res.partner.conductor.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Conductors">
                <field name="name"/>
                <field name="phone"/>
                <field name="role"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_conductor_form" model="ir.ui.view">
        <field name="name">res.partner.conductor.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Conductor Profile">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Conductor Full Name" required="1"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="role" readonly="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_conductors" model="ir.actions.act_window">
        <field name="name">Conductors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('role', '=', 'conductor')]</field>
        <field name="context">{'default_role': 'conductor', 'default_is_company': False}</field>
        <field name="help" type="html">
            <p class="o_nocontent_smiling_face">Register your first fleet conductor here.</p>
        </field>
    </record>

</odoo>
