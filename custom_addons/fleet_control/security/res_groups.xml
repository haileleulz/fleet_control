<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_fleet_control" model="ir.module.category">
        <field name="name">Fleet Control</field>
        <field name="description">Helps in control and allocation of buses</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_bus_dispatcher" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="category_id" ref="module_category_fleet_control"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_bus_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_fleet_control"/>
        <field name="implied_ids" eval="[(4, ref('group_bus_dispatcher'))]"/>
    </record>

</odoo>