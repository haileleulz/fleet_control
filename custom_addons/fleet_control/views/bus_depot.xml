<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="bus_depot_tree_view" model="ir.ui.view">
        <field name="name">bus.depot.tree</field>
        <field name="model">bus.depot</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="bus_depot_form_view" model="ir.ui.view">
        <field name="name">bus.depot.form</field>
        <field name="model">bus.depot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bus_depot" model="ir.actions.act_window">
        <field name="name">Bus Depot</field>
        <field name="res_model">bus.depot</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_nocontent_smiling_face">
                Create Your content here
            </p>
        </field>
    </record>
</odoo>
