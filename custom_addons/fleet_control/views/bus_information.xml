<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="bus_information_tree_view" model="ir.ui.view">
            <field name="name">bus.information.tree</field>
            <field name="model">bus.information</field>
            <field name="arch" type="xml">
                <tree decoration-success="status== 'active'" decoration-danger="status == 'inactive'">
                    <field name="bus_type"/>
                    <field name="side_plate"/>
                    <field name="license_plate"/>
                    <field name="depot_id"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="bus_information_form_view" model="ir.ui.view">
            <field name="name">bus.information.form</field>
            <field name="model">bus.information</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="bus_type"/>
                            <field name="side_plate"/>
                            <field name="license_plate" placeholder="AA-23456"/>
                            <field name="depot_id"/>
                            <field name="status"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_bus_information" model="ir.actions.act_window">
            <field name="name">Bus Information</field>
            <field name="res_model">bus.information</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_nocontent_smiling_face">
                    Create Your content here
                </p>
            </field>
        </record>

    </data>
</odoo>