<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="bus_station_tree_view" model="ir.ui.view">
        <field name="name">bus.station.tree</field>
        <field name="model">bus.station</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="station_type"/>
            </tree>
        </field>
    </record>

    <record id="bus_station_form_view" model="ir.ui.view">
        <field name="name">bus.station.form</field>
        <field name="model">bus.station</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="station_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bus_stations" model="ir.actions.act_window">
        <field name="name">Bus Stations</field>
        <field name="res_model">bus.station</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_nocontent_smiling_face">
                Create Your content here
            </p>
        </field>
    </record>
</odoo>
